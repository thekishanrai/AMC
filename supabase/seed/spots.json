    "distance_from_mumbai_km": 172,
    "distance_from_pune_km": 166,
    "time_by_car_minutes": 230,
    "time_by_bike_minutes": 270,
    "how_to_reach": "Drive to Bari village via Igatpuri or Bhandardara road; trailhead starts from Bari.",
    "nearest_station": "Kasara Railway Station — 40 km; taxis run on to Bari village.",
    "things_to_carry": ["Trekking shoes", "Headlamp", "2L water", "Light snacks"],
    "safety_note": "The iron ladders near the top get crowded and slippery in monsoon — climb one at a time and hold the rails.",
    "faqs": [
      {
        "question": "Is Kalsubai suitable for beginners?",
        "answer": "Yes, with a fitness base — it's rated moderate and the ladders are the only technical part."
      },
      {
        "question": "How long does the climb take?",
        "answer": "4-5 hours up from Bari village, and roughly the same coming down."
      },
      {
        "question": "Is it crowded?",
        "answer": "Very, especially on weekends and around sunrise — it's Maharashtra's most-climbed peak."
      },
      {
        "question": "Best time to go?",
        "answer": "October to February for clear skies; monsoon adds risk on the ladder sections."
      }
    ],
